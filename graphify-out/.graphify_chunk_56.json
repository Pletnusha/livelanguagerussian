    {"id":"livello_elementare_verbi_di_moto_complementi_dei_verbi_di_moto_moto_a_luogo_index_moto_a_luogo_concept","label":"MOTO A LUOGO — В/НА + accusativo, К + dativo","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\complementi-dei-verbi-di-moto\\moto-a-luogo\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Esprime il movimento verso un luogo: В/НА reggono l'accusativo per la destinazione fisica, К regge il dativo per il movimento verso una persona."},
    {"id":"livello_elementare_verbi_di_moto_complementi_dei_verbi_di_moto_moto_da_luogo_index_moto_da_luogo_concept","label":"MOTO DA LUOGO — ИЗ/С + genitivo, ОТ + genitivo","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\complementi-dei-verbi-di-moto\\moto-da-luogo\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Esprime il movimento da un luogo: regola delle coppie В→ИЗ, НА→С; ОТ si usa per allontanarsi da una persona, tutte al genitivo."},
    {"id":"livello_elementare_verbi_di_moto_complementi_dei_verbi_di_moto_moto_per_luogo_index_moto_per_luogo_concept","label":"MOTO PER LUOGO — ВДОЛЬ + genitivo, ПО + dativo","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\complementi-dei-verbi-di-moto\\moto-per-luogo\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Esprime il movimento attraverso un luogo: ВДОЛЬ (lungo, genitivo) contro ПО (attraverso/su, dativo)."},
    {"id":"livello_elementare_verbi_di_moto_futuro_poyti_skhodit_index_poyti_vs_skhodit_concept","label":"ПОЙТИ vs СХОДИТЬ (coppia aspettuale, futuro)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\futuro\\poyti-skhodit\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"пойти = azione futura monodirezionale senza ritorno previsto; сходить = gita rapida con ritorno previsto."},
    {"id":"livello_elementare_verbi_di_moto_futuro_verbi_specifici_futuro_poekhat_sezdit_index_poekhat_vs_sezdit_concept","label":"ПОЕХАТЬ vs СЪЕЗДИТЬ (coppia aspettuale, futuro)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\futuro\\verbi-specifici-futuro\\poekhat-sezdit\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"поехать = partenza in veicolo senza ritorno previsto; съездить = gita in veicolo con ritorno previsto."},
    {"id":"livello_elementare_verbi_di_moto_futuro_verbi_specifici_futuro_sbegat_pobezhat_index_sbegat_vs_pobezhat_concept","label":"СБЕГАТЬ vs ПОБЕЖАТЬ (coppia aspettuale, futuro)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\futuro\\verbi-specifici-futuro\\sbegat-pobezhat\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"сбегать = correre andata e ritorno, commissione veloce; побежать = iniziare a correre, partenza in una direzione."},
    {"id":"livello_elementare_verbi_di_moto_futuro_verbi_specifici_futuro_splavat_poplavat_index_splavat_vs_poplavat_concept","label":"СПЛАВАТЬ vs ПОПЛАВАТЬ (coppia aspettuale, futuro)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\futuro\\verbi-specifici-futuro\\splavat-poplavat\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"сплавать = nuotare andata e ritorno, commissione via acqua; поплавать = nuotare per un po', attività a durata limitata."},
    {"id":"livello_elementare_verbi_di_moto_idti_usi_speciali_index_idti_regola_doro_concept","label":"ИДТИ — la regola d'oro (in russo tutto cammina)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\idti-usi-speciali\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"ИДТИ non descrive solo il camminare a piedi ma è usato metaforicamente per meteo, tempo, processi in corso, affari, fenomeni fisici, estetica e discorso — un unico concetto di movimento applicato alla realtà in corso."},
    {"id":"livello_elementare_verbi_di_moto_passato_exat_ezdit_idiomi_index_exat_ezdit_idiomi_concept","label":"ЕХАТЬ / ЕЗДИТЬ — espressioni idiomatiche (stress, follia, viaggio)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\passato\\exat-ezdit-idiomi\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Il movimento diventa metafora: ездить по мозгам/ушам/нервам per esprimere pressione e manipolazione, крыша поехала per la perdita del controllo mentale, поехали/приехали come esclamazioni di inizio o esito."},
    {"id":"livello_elementare_verbi_di_moto_passato_exat_ezdit_passato_index_exal_vs_ezdil_concept","label":"ЕХАЛ vs ЕЗДИЛ (coppia aspettuale, passato)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\passato\\exat-ezdit-passato\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"ехал/ехала = viaggio specifico in un mezzo di trasporto in una direzione; ездил/ездила = abitudine o andata e ritorno."},
    {"id":"livello_elementare_verbi_di_moto_passato_idti_xodit_passato_index_shel_vs_khodil_concept","label":"ШЁЛ/ШЛА vs ХОДИЛ/ХОДИЛА (coppia aspettuale, passato)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\passato\\idti-xodit-passato\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"шёл/шла = viaggio specifico a piedi in una direzione; ходил/ходила = abitudine o andata e ritorno a piedi."},
    {"id":"livello_elementare_verbi_di_moto_passato_verbi_specifici_passato_correre_index_bezhal_vs_begal_concept","label":"БЕЖАЛ vs БЕГАЛ (coppia aspettuale, passato)","file_type":"concept","source_file":"C:\\Users\\Administrator\\Documents\\livelanguage 16.03 - Copia\\livelanguagerussian\\livello_elementare\\verbi-di-moto\\passato\\verbi-specifici-passato\\correre\\index.html","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"бежал/бежала = corsa specifica in una direzione; бегал/бегала = abitudine o corsa senza meta."}
